[
  {
    "name": "git",
    "display_name": "Git",
    "description": "Distributed version control system",
    "category": "DEVELOPMENT_TOOL",
    "profiles": ["core"],
    "required": true,
    "minimum_version": "2.30.0",
    "stable_policy": "latest-stable",
    "homepage": "https://git-scm.com",
    "verify": { "command": "git", "args": ["--version"] },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Git.Git"] }] },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["git"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["git"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["git"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["git"], "elevate": true }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["git"] }] }
    }
  },
  {
    "name": "git-lfs",
    "display_name": "Git LFS",
    "description": "Git extension for versioning large files",
    "category": "DEVELOPMENT_TOOL",
    "profiles": ["core"],
    "required": false,
    "requires": ["git"],
    "stable_policy": "latest-stable",
    "homepage": "https://git-lfs.com",
    "verify": { "command": "git-lfs", "args": ["--version"] },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["GitHub.GitLFS"], "post_install": [["git", "lfs", "install"]] }] },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["git-lfs"], "elevate": true, "post_install": [["git", "lfs", "install"]] },
          { "method": "package_manager", "manager": "dnf", "packages": ["git-lfs"], "elevate": true, "post_install": [["git", "lfs", "install"]] },
          { "method": "package_manager", "manager": "pacman", "packages": ["git-lfs"], "elevate": true, "post_install": [["git", "lfs", "install"]] },
          { "method": "package_manager", "manager": "zypper", "packages": ["git-lfs"], "elevate": true, "post_install": [["git", "lfs", "install"]] }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["git-lfs"], "post_install": [["git", "lfs", "install"]] }] }
    }
  },
  {
    "name": "github-cli",
    "display_name": "GitHub CLI",
    "description": "GitHub from the command line",
    "category": "CLI_TOOL",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://cli.github.com",
    "notes": "Older Debian and Ubuntu releases do not carry gh in their default archives; on those systems the install is reported as failed rather than silently skipped.",
    "verify": { "command": "gh", "args": ["--version"] },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["GitHub.cli"] }] },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["gh"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["gh"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["github-cli"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["gh"], "elevate": true }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["gh"] }] }
    }
  },
  {
    "name": "curl",
