  {
    "name": "openssh",
    "display_name": "OpenSSH Client",
    "description": "Secure shell client",
    "category": "CLI_TOOL",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://www.openssh.com",
    "verify": { "command": "ssh", "args": ["-V"], "pattern": "OpenSSH[_ ]([0-9]+\\.[0-9]+)" },
    "platforms": {
      "windows": {
        "install": [
          {
            "method": "manual",
            "reason": "The OpenSSH Client is a Windows optional feature and is enabled by default on Windows 10 1809 and later. Bento does not toggle Windows features automatically.",
            "url": "https://learn.microsoft.com/windows-server/administration/openssh/openssh_install_firstuse"
          }
        ]
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["openssh-client"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["openssh-clients"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["openssh"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["openssh"], "elevate": true }
        ]
      },
      "darwin": {
        "notes": "macOS ships OpenSSH in the base system.",
        "install": [{ "method": "bundled" }]
      }
    }
  },
  {
    "name": "make",
    "display_name": "Make",
    "description": "Build automation tool",
    "category": "DEVELOPMENT_TOOL",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://www.gnu.org/software/make/",
    "verify": { "command": "make", "args": ["--version"] },
    "platforms": {
      "windows": {
        "notes": "GnuWin32 Make does not always register itself on PATH; if verification fails after install, Make is reported as a warning rather than as working.",
        "install": [{ "method": "package_manager", "manager": "winget", "packages": ["GnuWin32.Make"] }]
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["make"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["make"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["make"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["make"], "elevate": true }
        ]
      },
      "darwin": {
        "notes": "The Xcode Command Line Tools provide make; Homebrew's package installs a newer GNU Make as gmake.",
        "install": [{ "method": "package_manager", "manager": "brew", "packages": ["make"] }]
      }
    }
  },
