      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["curl"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["curl"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["curl"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["curl"], "elevate": true }
        ]
      },
      "darwin": {
        "notes": "macOS ships curl in the base system.",
        "install": [{ "method": "package_manager", "manager": "brew", "packages": ["curl"] }]
      }
    }
  },
