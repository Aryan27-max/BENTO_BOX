  {
    "name": "vscode",
    "display_name": "Visual Studio Code",
    "description": "Code editor",
    "category": "GUI_APPLICATION",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://code.visualstudio.com",
    "verify": {
      "command": "code",
      "args": ["--version"],
      "paths": {
        "windows": [
          "${LOCALAPPDATA}/Programs/Microsoft VS Code/Code.exe",
          "${PROGRAMFILES}/Microsoft VS Code/Code.exe"
        ],
        "darwin": ["/Applications/Visual Studio Code.app"],
        "linux": ["/usr/share/code/code", "/snap/bin/code", "/usr/bin/code"]
      }
    },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Microsoft.VisualStudioCode"] }] },
      "linux": {
        "notes": "Microsoft publishes .deb and .rpm packages directly; the Arch package is the Code - OSS build.",
        "install": [
          {
            "method": "local_package",
            "urls": {
              "amd64": "https://update.code.visualstudio.com/latest/linux-deb-x64/stable",
              "arm64": "https://update.code.visualstudio.com/latest/linux-deb-arm64/stable"
            },
            "manager": "apt",
            "elevate": true
          },
          {
            "method": "local_package",
            "urls": {
              "amd64": "https://update.code.visualstudio.com/latest/linux-rpm-x64/stable",
              "arm64": "https://update.code.visualstudio.com/latest/linux-rpm-arm64/stable"
            },
            "manager": "dnf",
            "elevate": true
          },
          { "method": "package_manager", "manager": "snap", "packages": ["code"], "classic": true, "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["code"], "elevate": true }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["visual-studio-code"], "cask": true }] }
    }
  },
  {
    "name": "postman",
    "display_name": "Postman",
    "description": "API development and testing client",
    "category": "GUI_APPLICATION",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://www.postman.com",
    "verify": {
      "skip_version": true,
      "paths": {
        "windows": ["${LOCALAPPDATA}/Postman/Postman.exe"],
        "darwin": ["/Applications/Postman.app"],
        "linux": ["/snap/bin/postman", "/opt/Postman/Postman", "${HOME}/.local/share/Postman/Postman"]
      }
    },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Postman.Postman"] }] },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "snap", "packages": ["postman"], "elevate": true },
          {
            "method": "manual",
            "reason": "Postman ships a tarball for Linux rather than distribution packages, and snapd is not available on this system.",
            "url": "https://www.postman.com/downloads/"
          }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["postman"], "cask": true }] }
    }
  },
  {
    "name": "docker",
    "display_name": "Docker",
    "description": "Container runtime and tooling",
    "category": "SERVICE",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://www.docker.com",
    "verify": { "command": "docker", "args": ["--version"] },
    "service": {
      "names": { "linux": "docker", "windows": "com.docker.service", "darwin": "docker" },
      "required": false,
      "notes": "Installation and runtime are separate: Bento reports whether the Docker daemon is running but does not start Docker Desktop for you."
    },
    "platforms": {
      "windows": {
        "elevate": true,
        "restart_required": true,
        "notes": "Docker Desktop needs WSL2 or Hyper-V and usually requires a restart before the daemon runs.",
        "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Docker.DockerDesktop"] }],
        "service": { "names": { "windows": "com.docker.service" }, "manual": true, "notes": "Docker Desktop is launched by the user, not by Bento." }
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["docker.io"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["moby-engine"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["docker"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["docker"], "elevate": true }
        ],
        "notes": "Running docker without sudo requires adding your user to the docker group; Bento does not change group membership because it grants root-equivalent access."
      },
      "darwin": {
        "install": [
          { "method": "package_manager", "manager": "brew", "packages": ["docker-desktop"], "cask": true },
          { "method": "package_manager", "manager": "brew", "packages": ["docker"], "cask": true }
        ],
        "service": { "names": { "darwin": "docker" }, "manual": true, "notes": "Docker Desktop is launched by the user, not by Bento." }
      }
    }
  }
]
