[
  {
    "name": "cpp-toolchain",
    "display_name": "C / C++ Toolchain",
    "description": "System C and C++ compiler toolchain",
    "category": "LANGUAGE",
    "profiles": ["core"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://gcc.gnu.org",
    "verify": { "command": "gcc", "args": ["--version"] },
    "platforms": {
      "windows": {
        "notes": "Bento installs the LLVM/Clang toolchain on Windows because it registers itself on PATH; the MSVC Build Tools are a much larger install that Bento leaves to the user.",
        "install": [{ "method": "package_manager", "manager": "winget", "packages": ["LLVM.LLVM"] }],
        "verify": { "command": "clang", "args": ["--version"] }
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["build-essential"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["gcc", "gcc-c++", "make"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["base-devel"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["gcc", "gcc-c++", "make"], "elevate": true }
        ]
      },
      "darwin": {
        "notes": "Clang comes from the Xcode Command Line Tools; the installer opens a system dialog.",
        "install": [{ "method": "command", "command": ["xcode-select", "--install"] }],
        "verify": { "command": "clang", "args": ["--version"] }
      }
    }
  },
  {
    "name": "python",
    "display_name": "Python",
    "description": "Python interpreter and standard library",
    "category": "LANGUAGE",
    "profiles": ["ai", "web"],
    "required": true,
    "minimum_version": "3.10.0",
    "stable_policy": "latest-stable",
    "homepage": "https://www.python.org",
    "verify": { "command": "python3", "args": ["--version"] },
    "platforms": {
      "windows": {
        "notes": "winget publishes one package per minor release; Bento tries the newest first and falls back, which keeps version numbers in data rather than in code.",
        "install": [
          { "method": "package_manager", "manager": "winget", "packages": ["Python.Python.3.13"] },
          { "method": "package_manager", "manager": "winget", "packages": ["Python.Python.3.12"] }
        ],
        "verify": { "command": "python", "args": ["--version"], "pattern": "Python ([0-9]+\\.[0-9]+\\.[0-9]+)" }
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["python3", "python3-pip", "python3-venv"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["python3", "python3-pip"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["python", "python-pip"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["python3", "python3-pip"], "elevate": true }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["python"] }] }
    }
  },
