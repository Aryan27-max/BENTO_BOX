  {
    "name": "go",
    "display_name": "Go",
    "description": "Go programming language toolchain",
    "category": "LANGUAGE",
    "profiles": ["blockchain", "web"],
    "required": true,
    "minimum_version": "1.21.0",
    "stable_policy": "latest-stable",
    "homepage": "https://go.dev",
    "verify": { "command": "go", "args": ["version"] },
    "environment": [
      { "name": "GOROOT", "value": "", "from_command": ["go", "env", "GOROOT"] },
      { "name": "GOPATH", "value": "", "from_command": ["go", "env", "GOPATH"] }
    ],
    "path_entries": [{ "path": "bin", "from_command": ["go", "env", "GOPATH"] }],
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["GoLang.Go"] }] },
      "linux": {
        "notes": "The official go.dev tarball is preferred because distribution packages frequently lag several releases behind.",
        "install": [
          { "method": "archive", "resolver": "go_stable", "install_dir": "go" },
          { "method": "package_manager", "manager": "apt", "packages": ["golang-go"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["golang"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["go"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["go"], "elevate": true }
        ]
      },
      "darwin": {
        "install": [
          { "method": "package_manager", "manager": "brew", "packages": ["go"] },
          { "method": "archive", "resolver": "go_stable", "install_dir": "go" }
        ]
      }
    }
  },
  {
    "name": "rust",
    "display_name": "Rust",
    "description": "Rust toolchain managed by rustup",
    "category": "LANGUAGE",
    "profiles": ["blockchain"],
    "required": true,
    "stable_policy": "latest-stable",
    "homepage": "https://www.rust-lang.org",
    "verify": {
      "command": "rustc",
      "args": ["--version"],
      "components": [
        { "name": "rustup", "command": "rustup", "args": ["--version"] },
        { "name": "cargo", "command": "cargo", "args": ["--version"] },
        { "name": "rustfmt", "command": "rustfmt", "args": ["--version"] },
        { "name": "clippy", "command": "cargo", "args": ["clippy", "--version"] }
      ]
    },
    "environment": [
      { "name": "CARGO_HOME", "value": "${HOME}/.cargo" },
      { "name": "RUSTUP_HOME", "value": "${HOME}/.rustup" }
    ],
    "path_entries": [{ "path": "${HOME}/.cargo/bin" }],
    "platforms": {
      "windows": {
        "notes": "The default x86_64-pc-windows-msvc toolchain needs the MSVC linker; install the Visual Studio Build Tools if linking fails.",
        "install": [
          {
            "method": "package_manager",
            "manager": "winget",
            "packages": ["Rustlang.Rustup"],
            "post_install": [
              ["rustup", "toolchain", "install", "stable"],
              ["rustup", "default", "stable"],
              ["rustup", "component", "add", "rustfmt", "clippy"]
            ]
          }
        ]
      },
      "linux": {
        "install": [
          {
            "method": "installer",
            "urls": {
              "amd64": "https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init",
              "arm64": "https://static.rust-lang.org/rustup/dist/aarch64-unknown-linux-gnu/rustup-init"
            },
            "installer_args": ["-y", "--no-modify-path", "--default-toolchain", "stable", "--profile", "default"],
            "post_install": [["rustup", "component", "add", "rustfmt", "clippy"]]
          }
        ]
      },
      "darwin": {
        "install": [
          {
            "method": "installer",
            "urls": {
              "amd64": "https://static.rust-lang.org/rustup/dist/x86_64-apple-darwin/rustup-init",
              "arm64": "https://static.rust-lang.org/rustup/dist/aarch64-apple-darwin/rustup-init"
            },
            "installer_args": ["-y", "--no-modify-path", "--default-toolchain", "stable", "--profile", "default"],
            "post_install": [["rustup", "component", "add", "rustfmt", "clippy"]]
          }
        ]
      }
    }
  },
  {
    "name": "java",
    "display_name": "Java (OpenJDK)",
    "description": "Java Development Kit, LTS release",
    "category": "LANGUAGE",
    "profiles": ["app"],
    "required": true,
    "minimum_version": "17.0.0",
    "stable_policy": "latest-lts",
    "homepage": "https://openjdk.org",
    "verify": { "command": "java", "args": ["-version"], "pattern": "version \"([0-9][0-9._]*)\"" },
    "platforms": {
      "windows": {
        "install": [
          { "method": "package_manager", "manager": "winget", "packages": ["Microsoft.OpenJDK.21"] },
          { "method": "package_manager", "manager": "winget", "packages": ["EclipseAdoptium.Temurin.21.JDK"] }
        ]
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["openjdk-21-jdk"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["java-21-openjdk-devel"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["jdk-openjdk"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["java-21-openjdk-devel"], "elevate": true }
        ]
      },
      "darwin": {
        "notes": "Homebrew keeps the JDK unlinked; Bento adds the keg's bin directory to PATH and sets JAVA_HOME from java_home.",
        "install": [{ "method": "package_manager", "manager": "brew", "packages": ["openjdk@21"] }],
        "environment": [{ "name": "JAVA_HOME", "value": "", "from_command": ["/usr/libexec/java_home"], "os": "darwin" }],
        "path_entries": [{ "path": "bin", "from_command": ["brew", "--prefix", "openjdk@21"], "os": "darwin" }]
      }
    }
  },
  {
    "name": "kotlin",
    "display_name": "Kotlin",
    "description": "Kotlin command line compiler",
    "category": "LANGUAGE",
    "profiles": ["app"],
    "required": false,
    "requires": ["java"],
    "stable_policy": "latest-stable",
    "homepage": "https://kotlinlang.org",
    "verify": { "command": "kotlinc", "args": ["-version"], "pattern": "kotlinc-jvm ([0-9]+\\.[0-9]+\\.[0-9]+)" },
    "platforms": {
      "windows": {
        "install": [
          {
            "method": "manual",
            "reason": "JetBrains distributes the Kotlin compiler as a GitHub release archive or through SDKMAN and IntelliJ; there is no official winget package to install from.",
            "url": "https://kotlinlang.org/docs/command-line.html"
          }
        ]
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "snap", "packages": ["kotlin"], "classic": true, "elevate": true },
          {
            "method": "manual",
            "reason": "The Kotlin compiler is published as a snap or a GitHub release archive, and snapd is not available on this system.",
            "url": "https://kotlinlang.org/docs/command-line.html"
          }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["kotlin"] }] }
    }
  },
