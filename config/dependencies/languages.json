  {
    "name": "node",
    "display_name": "Node.js",
    "description": "JavaScript runtime",
    "category": "RUNTIME",
    "profiles": ["web", "blockchain", "app"],
    "required": true,
    "minimum_version": "20.0.0",
    "stable_policy": "latest-lts",
    "homepage": "https://nodejs.org",
    "verify": { "command": "node", "args": ["--version"] },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["OpenJS.NodeJS.LTS"] }] },
      "linux": {
        "notes": "Distribution packages are tried first; when they are older than the minimum supported version Bento falls back to the official Node.js LTS tarball.",
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["nodejs", "npm"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["nodejs", "npm"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["nodejs", "npm"], "elevate": true },
          { "method": "package_manager", "manager": "zypper", "packages": ["nodejs", "npm"], "elevate": true },
          { "method": "archive", "resolver": "node_lts", "install_dir": "node" }
        ]
      },
      "darwin": {
        "install": [
          { "method": "package_manager", "manager": "brew", "packages": ["node"] },
          { "method": "archive", "resolver": "node_lts", "install_dir": "node" }
        ]
      }
    }
  },
