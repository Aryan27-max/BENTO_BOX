  {
    "name": "ollama",
    "display_name": "Ollama",
    "description": "Run large language models locally",
    "category": "SERVICE",
    "profiles": ["ai"],
    "required": false,
    "stable_policy": "latest-stable",
    "homepage": "https://ollama.com",
    "verify": { "command": "ollama", "args": ["--version"], "pattern": "version is ([0-9.]+)" },
    "service": {
      "names": { "linux": "ollama", "darwin": "ollama", "windows": "ollama" },
      "required": false,
      "manual": true,
      "notes": "Ollama runs as a user-launched background server; Bento installs it but does not start or enable it."
    },
    "platforms": {
      "windows": { "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Ollama.Ollama"] }] },
      "linux": {
        "notes": "Installed from Ollama's official release tarball rather than by piping their install script into a shell.",
        "install": [
          {
            "method": "archive",
            "urls": {
              "amd64": "https://ollama.com/download/ollama-linux-amd64.tgz",
              "arm64": "https://ollama.com/download/ollama-linux-arm64.tgz"
            },
            "install_dir": "ollama"
          }
        ]
      },
      "darwin": { "install": [{ "method": "package_manager", "manager": "brew", "packages": ["ollama"], "cask": true }] }
    }
  },
  {
    "name": "cuda-toolkit",
    "display_name": "CUDA Toolkit",
    "description": "NVIDIA GPU compute toolkit",
    "category": "SDK",
    "profiles": ["ai"],
    "required": false,
    "requires_gpu": "nvidia",
    "stable_policy": "latest-stable",
    "homepage": "https://developer.nvidia.com/cuda-toolkit",
    "notes": "Only planned when an NVIDIA GPU is actually detected. Bento never installs CUDA on a machine that cannot use it.",
    "verify": { "command": "nvcc", "args": ["--version"], "pattern": "release ([0-9]+\\.[0-9]+)" },
    "unsupported": {
      "darwin": "NVIDIA CUDA has not been supported on macOS since macOS 10.13."
    },
    "platforms": {
      "windows": {
        "elevate": true,
        "restart_required": true,
        "install": [{ "method": "package_manager", "manager": "winget", "packages": ["Nvidia.CUDA"] }]
      },
      "linux": {
        "install": [
          { "method": "package_manager", "manager": "apt", "packages": ["nvidia-cuda-toolkit"], "elevate": true },
          { "method": "package_manager", "manager": "dnf", "packages": ["cuda"], "elevate": true },
          { "method": "package_manager", "manager": "pacman", "packages": ["cuda"], "elevate": true },
          {
            "method": "manual",
            "reason": "This distribution does not package the CUDA toolkit; NVIDIA's own repository must be added first.",
            "url": "https://developer.nvidia.com/cuda-downloads"
          }
        ]
      }
    }
  }
]
